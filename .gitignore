# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/vercel-frontend/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/.venv-e2e/
__pycache__/
*.pyc

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/vercel-frontend/dist/
/vercel-frontend/*.tsbuildinfo
*.tsbuildinfo
/.wrangler/
/outputs/
/work/
