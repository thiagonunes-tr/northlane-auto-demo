        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "plate": {
            "type": "string",
            "maxLength": 12
          },
          "insurer": {
            "type": "string",
            "maxLength": 80
          }
        },
        "description": "The other party in an incident. Optional, but all three fields are required together."
      },
      "Inspection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shop",
          "scheduledFor",
          "outcome",
          "notes"
        ],
        "properties": {
          "shop": {
            "type": "string"
          },
          "scheduledFor": {
            "type": "string"
          },
          "outcome": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "damage-confirmed",
                  "damage-disputed"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 400
          }
        }
      },
      "AssistanceRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "location",
          "status",
          "requestedAt",
          "provider",
          "etaMinutes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/AssistanceKind"
          },
          "location": {
            "type": "string",
            "maxLength": 160
          },
          "status": {
            "type": "string",
            "enum": [
              "requested",
              "dispatched",
              "completed"
            ]
          },
          "requestedAt": {
            "type": "string"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "etaMinutes": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "description": "Only available when the roadside add-on is on the policy."
      },
      "AssistanceInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "location"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/AssistanceKind"
          },
          "location": {
            "type": "string",
            "maxLength": 160
          }
        }
      },
      "PaymentMethod": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "last4",
          "expiry",
          "nameOnCard",
          "addedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "last4": {
            "type": "string",
            "maxLength": 4
          },
          "expiry": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-2])/\\d{2}$"
          },
          "nameOnCard": {
            "type": "string",
            "maxLength": 80
          },
          "addedAt": {
            "type": "string"
          }
        },
        "description": "A saved card. The number itself is never stored."
      }
    }
  },
  "security": [
    {
      "sessionCookie": []
    }
  ]
}
