              "request-quote",
              "accept-quote",
              "discard-quote",
              "renew-policy",
              "cancel-policy",
              "add-vehicle",
              "update-vehicle",
              "remove-vehicle",
              "add-driver",
              "update-driver",
              "remove-driver",
              "file-claim",
              "upload-claim-document",
              "respond-to-claim-review",
              "request-assistance",
              "pay-invoice",
              "save-payment-method",
              "remove-payment-method",
              "change-instalment-plan",
              "send-message",
              "mark-messages-read",
              "start-claim-review",
              "assign-repair-shop",
              "schedule-inspection",
              "record-inspection",
              "request-claim-information",
              "approve-claim",
              "reject-claim",
              "settle-claim",
              "dispatch-assistance",
              "complete-assistance",
              "refund-invoice",
              "lapse-policy"
            ]
          },
          "coverage": {
            "$ref": "#/components/schemas/CoverageTier"
          },
          "addOns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddOnId"
            },
            "description": "Deduplicated and reordered by the server."
          },
          "deductible": {
            "$ref": "#/components/schemas/DeductibleChoice"
          },
          "vehicle": {
            "$ref": "#/components/schemas/VehicleInput"
          },
          "vehicleId": {
            "type": "string"
          },
          "driver": {
            "$ref": "#/components/schemas/DriverInput"
          },
          "driverId": {
            "type": "string"
          },
          "claim": {
            "$ref": "#/components/schemas/ClaimInput"
          },
          "document": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fileName"
            ],
            "properties": {
              "fileName": {
                "type": "string",
                "maxLength": 160
              },
              "sizeLabel": {
                "type": "string",
                "maxLength": 20
              }
            }
          },
          "reviewNote": {
            "type": "string",
            "maxLength": 400,
            "description": "Required by every agent decision."
          },
          "repairShop": {
            "$ref": "#/components/schemas/RepairShop"
          },
          "inspection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome",
              "notes"
            ],
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "damage-confirmed",
                  "damage-disputed"
                ]
              },
              "notes": {
                "type": "string",
                "maxLength": 400
              }
            }
          },
          "assistance": {
            "$ref": "#/components/schemas/AssistanceInput"
          },
          "assistanceId": {
            "type": "string"
          },
          "card": {
            "$ref": "#/components/schemas/CardInput"
          },
          "paymentMethodId": {
            "type": "string"
          },
          "invoiceId": {
            "type": "string"
          },
          "instalmentPlan": {
            "$ref": "#/components/schemas/InstalmentPlan"
          },
          "reason": {
            "type": "string",
            "maxLength": 200,
            "description": "Required to cancel a policy or refund an invoice."
          },
          "messageBody": {
            "type": "string",
            "maxLength": 500
          }
        },
        "description": "One action plus whatever that action needs. Fields not relevant to the action are ignored."
      },
      "AddOnId": {
        "type": "string",
        "enum": [
          "courtesy-car",
          "roadside",
          "glass",
          "third-party-plus"
        ],
        "description": "Optional cover, priced as a flat annual amount each."
      },
      "DeductibleChoice": {
        "type": "integer",
        "enum": [
          250,
          500,
          750,
          1000
        ],
        "description": "Carrying more of a claim yourself lowers the premium."
      },
      "InstalmentPlan": {
        "type": "string",
        "enum": [
          "annual",
          "monthly"
        ]
      },
      "PolicyStatus": {
        "type": "string",
        "enum": [
          "active",
          "lapsed",
          "cancelled"
        ],
        "description": "`lapsed` follows non-payment and is cleared by paying what is overdue."
      },
      "AssistanceKind": {
        "type": "string",
        "enum": [
          "Tow",
          "Battery",
          "Flat tyre",
          "Lockout",
          "Fuel"
        ]
      },
      "RepairShop": {
        "type": "string",
        "enum": [
          "Northgate Auto Body",
          "Lakeside Collision Centre",
          "Prairie Street Garage"
        ]
      },
      "PriceLine": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
