{
  "openapi": "3.1.0",
  "info": {
    "title": "Northlane Auto Demo API",
    "version": "1.0.0",
    "description": "The complete HTTP contract of the Northlane Auto Insurance demo.\n\nThis is a fictional insurer built for QA automation training. No policy exists, no claim is real, and no money moves.\n\n**Signing in.** There are two ways.\n\n`POST /api/auth/login` with `skipMfa: true` and one of the two shared demo accounts returns a session cookie in one call. That is the path automation should take: no mailbox, no waiting.\n\n| Account | Password |\n| --- | --- |\n| `customer.demo@testrigor-mail.com` | `CustomerDemo!2026` |\n| `agent.demo@testrigor-mail.com` | `AgentDemo!2026` |\n\nWithout `skipMfa`, the endpoint opens a two-step verification challenge and sends a real six-digit code by email. `POST /api/auth/verify` exchanges it for a session. Codes are single-use, expire in 10 minutes, and lock the challenge after five wrong attempts. Requesting them is rate limited: one a minute and five an hour per address.\n\n**Driving the workflow.** Every business transition goes through `PATCH /api/demo-state`. The state is a single row shared by every session, so the policyholder and the agent see each other's changes. `DELETE /api/demo-state` restores the seed data.\n\n**Status codes carry meaning.** `403` means the signed-in role may never perform that action. `400` means the request is malformed. `409` means the request is well-formed but the state is not ready for it."
  },
  "servers": [
    {
      "url": "/",
      "description": "The current environment"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Sign-in, two-step verification, session and account lifecycle."
    },
    {
      "name": "Demo state",
      "description": "The shared quote, policy, claim, billing and messaging workflow."
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "login",
        "summary": "Sign in, or open a two-step verification challenge",
        "description": "Signs a shared demo account in directly when `skipMfa` is true. Otherwise sends a six-digit code by email and opens a verification challenge. An email that matches no account is treated as a registration when the password is at least 8 characters.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "examples": {
                "fixedAccountBypass": {
                  "summary": "Fixed demo account, no verification step",
                  "value": {
                    "email": "customer.demo@testrigor-mail.com",
                    "password": "CustomerDemo!2026",
                    "role": "customer",
                    "skipMfa": true
                  }
                },
                "fixedAccountChallenge": {
                  "summary": "Fixed demo account, code sent by email",
                  "value": {
                    "email": "customer.demo@testrigor-mail.com",
                    "password": "CustomerDemo!2026",
                    "role": "customer"
                  }
                },
                "agentAccount": {
                  "summary": "Claims agent, no verification step",
                  "value": {
                    "email": "agent.demo@testrigor-mail.com",
                    "password": "AgentDemo!2026",
                    "role": "agent",
                    "skipMfa": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A session was created, or a verification challenge was opened.",
            "headers": {
              "Set-Cookie": {
                "description": "Present only when `skipMfa` created a session.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SessionResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ChallengeResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "502": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/auth/verify": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "verifyMfa",
        "summary": "Exchange a verification code for a session",
        "description": "Consumes the challenge. A code can be used once, expires after 10 minutes, and locks the challenge after 5 incorrect attempts.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              },
              "examples": {
                "emailedCode": {
                  "summary": "The six digits from the message",
                  "value": {
                    "challengeId": "3f6c9a1e-0d2b-4b6f-9f3c-2a1b7d8e5c40",
                    "code": "482915"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The code matched and a session cookie was set.",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "410": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "operationId": "getSession",
        "summary": "Read the signed-in account",
        "description": "Answers with `user: null` rather than 401 when there is no valid session, so the client can render the sign-in screen without treating it as an error.",
        "responses": {
          "200": {
            "description": "The signed-in account, or null.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "user"
                  ],
                  "properties": {
                    "user": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/User"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "logout",
        "summary": "Clear the session cookie",
        "responses": {
          "200": {
            "description": "The cookie was cleared. Always succeeds, session or not.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/account": {
      "delete": {
        "tags": [
          "Authentication"
        ],
        "operationId": "deleteAccount",
        "summary": "Delete the signed-in account",
        "description": "Removes the user, its pending registrations and its verification challenges. The two fixed demo accounts are protected so shared QA credentials always work. The shared workflow state is never affected.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteAccountRequest"
              },
              "examples": {
                "confirmed": {
                  "summary": "Password plus the literal word DELETE",
                  "value": {
                    "password": "MyDemoPassword1",
                    "confirmation": "DELETE"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The account was deleted and the session cleared.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ok"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/demo-state": {
      "get": {
        "tags": [
          "Demo state"
        ],
        "operationId": "getDemoState",
        "summary": "Read the shared workflow state",
        "responses": {
          "200": {
            "$ref": "#/components/responses/DemoState"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "patch": {
        "tags": [
          "Demo state"
        ],
        "operationId": "updateDemoState",
        "summary": "Apply one workflow transition",
        "description": "The single write endpoint. The signed-in role decides which actions are permitted: the policyholder quotes, buys, updates details, files and documents claims, and pays; the agent reviews, decides and settles. Both may message.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoStateActionRequest"
              },
              "examples": {
                "quoteWithAddOns": {
                  "summary": "Price a different cover, with optional extras",
                  "value": {
                    "action": "request-quote",
                    "coverage": "Comprehensive",
                    "addOns": [
                      "roadside",
                      "glass"
                    ],
                    "deductible": 500
                  }
                },
                "addVehicle": {
                  "summary": "Put a second car on the policy",
                  "value": {
                    "action": "add-vehicle",
                    "vehicle": {
                      "year": "2021",
                      "make": "Toyota",
                      "model": "Corolla",
                      "vin": "JTDBR32E720012345",
                      "plate": "9LMN044",
                      "primaryUse": "Pleasure"
                    }
                  }
                },
                "renew": {
                  "summary": "Renew, adding a claim-free year to the bonus",
                  "value": {
                    "action": "renew-policy"
                  }
                },
                "cancel": {
                  "summary": "Cancel; a reason is required",
                  "value": {
                    "action": "cancel-policy",
                    "reason": "Sold the car."
                  }
                },
                "fileSmallClaim": {
                  "summary": "At or under $2,000, so approved automatically",
                  "value": {
                    "action": "file-claim",
                    "claim": {
                      "type": "Glass",
                      "incidentDate": "2026-07-18",
                      "description": "Stone chip in the windscreen.",
                      "estimatedAmount": 640
                    }
                  }
                },
                "fileClaimWithThirdParty": {
                  "summary": "Above $2,000, with the other driver's details",
                  "value": {
                    "action": "file-claim",
                    "claim": {
                      "type": "Collision",
                      "incidentDate": "2026-07-18",
                      "description": "Rear-ended at a junction.",
                      "estimatedAmount": 4200,
                      "thirdParty": {
                        "name": "Jordan Miller",
                        "plate": "7BKD221",
                        "insurer": "Cedar Mutual"
                      }
                    }
                  }
                },
                "recordInspection": {
                  "summary": "Agent: what the inspection found",
                  "value": {
                    "action": "record-inspection",
                    "inspection": {
                      "outcome": "damage-confirmed",
                      "notes": "Rear panel and boot lid, as described."
                    }
                  }
                },
                "requestAssistance": {
                  "summary": "Needs the roadside add-on on the policy",
                  "value": {
                    "action": "request-assistance",
                    "assistance": {
                      "kind": "Tow",
                      "location": "I-80 westbound, mile 42"
                    }
                  }
                },
                "payWithSavedCard": {
                  "summary": "Pay without re-entering a card",
                  "value": {
                    "action": "pay-invoice",
                    "paymentMethodId": "card-1"
                  }
                },
                "payInvoiceDeclined": {
                  "summary": "Any card but the demo one is declined with 409",
                  "value": {
                    "action": "pay-invoice",
                    "card": {
                      "nameOnCard": "Alex Carter",
                      "cardNumber": "5555555555554444",
                      "expiry": "01/29",
                      "cvv": "999"
                    }
                  }
                },
                "refund": {
                  "summary": "Agent: refund a paid invoice, with a reason",
                  "value": {
                    "action": "refund-invoice",
                    "invoiceId": "invoice-jun",
                    "reason": "Duplicate charge."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/DemoState"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "tags": [
          "Demo state"
        ],
        "operationId": "resetDemoState",
        "summary": "Restore the seed workflow state",
        "description": "Available to the two fixed demo accounts only. The environment also resets itself every 24 hours.",
        "responses": {
          "200": {
            "$ref": "#/components/responses/DemoState"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "northlane_session",
        "description": "An HTTP-only signed cookie set by login or verify. A browser sends it automatically."
      }
    },
    "responses": {
      "Error": {
        "description": "The request was refused. The message is written for an integrator.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "DemoState": {
        "description": "The shared workflow state after the request.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state"
              ],
              "properties": {
                "state": {
                  "$ref": "#/components/schemas/DemoState"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "examples": [
              "Only a claim in review can be decided."
            ]
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "customer",
          "agent"
        ],
        "description": "`customer` is the policyholder; `agent` is the claims agent."
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "name",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "ChallengeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challengeId",
          "destination",
          "expiresInSeconds"
        ],
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "destination": {
            "type": "string",
            "description": "The masked email the challenge belongs to.",
            "examples": [
              "cus•••••••••@testrigor-mail.com"
            ]
          },
          "expiresInSeconds": {
            "type": "integer",
            "examples": [
              600
            ]
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "skipMfa": {
            "type": "boolean",
            "default": false,
            "description": "Fixed demo accounts only. Any other account gets 403."
          }
        }
      },
      "VerifyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challengeId",
          "code"
        ],
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        }
      },
      "DeleteAccountRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "password",
          "confirmation"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "confirmation": {
            "type": "string",
            "const": "DELETE"
          }
        }
      },
      "CoverageTier": {
        "type": "string",
        "enum": [
          "Liability",
          "Standard",
          "Comprehensive"
        ]
      },
      "VehicleUse": {
        "type": "string",
        "enum": [
          "Commute",
          "Pleasure",
          "Business"
        ]
      },
      "ClaimType": {
        "type": "string",
        "enum": [
          "Collision",
          "Theft",
          "Glass",
          "Weather"
        ]
      },
      "ClaimStatus": {
        "type": "string",
        "enum": [
          "submitted",
          "in-review",
          "inspection-scheduled",
          "more-info-needed",
          "approved",
          "rejected",
          "settled"
        ],
        "description": "`submitted` is Pending Review. An estimate at or under $2,000 skips it and arrives as `approved`."
      },
      "Vehicle": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "year",
          "make",
          "model",
          "vin",
          "plate",
          "primaryUse",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "year": {
            "type": "string",
            "pattern": "^(19|20)\\d{2}$"
          },
          "make": {
            "type": "string",
            "maxLength": 40
          },
          "model": {
            "type": "string",
            "maxLength": 40
          },
          "vin": {
            "type": "string",
            "maxLength": 20
          },
          "plate": {
            "type": "string",
            "maxLength": 12
          },
          "primaryUse": {
            "$ref": "#/components/schemas/VehicleUse"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "VehicleInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "year",
          "make",
          "model",
          "vin",
          "plate",
          "primaryUse"
        ],
        "properties": {
          "year": {
            "type": "string",
            "pattern": "^(19|20)\\d{2}$"
          },
          "make": {
            "type": "string",
            "maxLength": 40
          },
          "model": {
            "type": "string",
            "maxLength": 40
          },
          "vin": {
            "type": "string",
            "maxLength": 20
          },
          "plate": {
            "type": "string",
            "maxLength": 12
          },
          "primaryUse": {
            "$ref": "#/components/schemas/VehicleUse"
          }
        }
      },
      "Driver": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fullName",
          "licenseNumber",
          "licenseState",
          "yearsLicensed",
          "isPrimary",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fullName": {
            "type": "string",
            "maxLength": 80
          },
          "licenseNumber": {
            "type": "string",
            "maxLength": 30
          },
          "licenseState": {
            "type": "string",
            "maxLength": 40
          },
          "yearsLicensed": {
            "type": "string",
            "pattern": "^\\d{1,2}$"
          },
          "isPrimary": {
            "type": "boolean",
            "description": "The policyholder. Cannot be removed."
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "DriverInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fullName",
          "licenseNumber",
          "licenseState",
          "yearsLicensed"
        ],
        "properties": {
          "fullName": {
            "type": "string",
            "maxLength": 80
          },
          "licenseNumber": {
            "type": "string",
            "maxLength": 30
          },
          "licenseState": {
            "type": "string",
            "maxLength": 40
          },
          "yearsLicensed": {
            "type": "string",
            "pattern": "^\\d{1,2}$"
          }
        }
      },
      "Policy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "status",
          "coverage",
          "addOns",
          "deductible",
          "annualPremium",
          "instalmentPlan",
          "effectiveFrom",
          "renewsOn",
          "noClaimsYears",
          "updatedAt",
          "endedOn",
          "endedReason"
        ],
        "properties": {
          "number": {
            "type": "string",
            "examples": [
              "NL-2026-004821"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/PolicyStatus"
          },
          "coverage": {
            "$ref": "#/components/schemas/CoverageTier"
          },
          "addOns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddOnId"
            }
          },
          "deductible": {
            "$ref": "#/components/schemas/DeductibleChoice"
          },
          "annualPremium": {
            "type": "integer",
            "minimum": 0
          },
          "instalmentPlan": {
            "$ref": "#/components/schemas/InstalmentPlan"
          },
          "effectiveFrom": {
            "type": "string"
          },
          "renewsOn": {
            "type": "string"
          },
          "noClaimsYears": {
            "type": "integer",
            "minimum": 0,
            "description": "Claim-free years. 5% off each, capped at 25%. Reset to 0 when a claim settles."
          },
          "updatedAt": {
            "type": "string"
          },
          "endedOn": {
            "type": [
              "string",
              "null"
            ]
          },
          "endedReason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Quote": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "kind",
          "coverage",
          "addOns",
          "deductible",
          "annualPremium",
          "monthlyPremium",
          "breakdown",
          "quotedAt"
        ],
        "properties": {
          "reference": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "new-business",
              "endorsement"
            ],
            "description": "An endorsement changes the policy in force; new business issues a fresh one."
          },
          "coverage": {
            "$ref": "#/components/schemas/CoverageTier"
          },
          "addOns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddOnId"
            }
          },
          "deductible": {
            "$ref": "#/components/schemas/DeductibleChoice"
          },
          "annualPremium": {
            "type": "integer",
            "minimum": 0
          },
          "monthlyPremium": {
            "type": "integer",
            "minimum": 0
          },
          "breakdown": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceLine"
            },
            "description": "Every line that moved the price, so the total is never unexplained."
          },
          "quotedAt": {
            "type": "string"
          }
        }
      },
      "ClaimDocument": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fileName",
          "sizeLabel",
          "uploadedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fileName": {
            "type": "string",
            "maxLength": 160
          },
          "sizeLabel": {
            "type": "string"
          },
          "uploadedAt": {
            "type": "string"
          }
        },
        "description": "No file is uploaded, read, or stored. Only the name and size are recorded."
      },
      "ClaimInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "incidentDate",
          "description",
          "estimatedAmount"
        ],
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ClaimType"
          },
          "incidentDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "description": {
            "type": "string",
            "maxLength": 400
          },
          "estimatedAmount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "description": "Whole US dollars. At or under 2000 the claim is approved automatically."
          },
          "thirdParty": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ThirdParty"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Claim": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "type",
          "incidentDate",
          "description",
          "estimatedAmount",
          "status",
          "filedAt",
          "autoApproved",
          "reviewNote",
          "documents",
          "thirdParty",
          "repairShop",
          "inspection",
          "settlementAmount",
          "settledDeductible"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "examples": [
              "CLM-2026-7714"
            ]
          },
          "type": {
            "$ref": "#/components/schemas/ClaimType"
          },
          "incidentDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "description": {
            "type": "string",
            "maxLength": 400
          },
          "estimatedAmount": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/ClaimStatus"
          },
          "filedAt": {
            "type": "string"
          },
          "autoApproved": {
            "type": "boolean",
            "description": "True when the fast-track rule decided this, not an agent."
          },
          "reviewNote": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 400
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClaimDocument"
            }
          },
          "thirdParty": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ThirdParty"
              },
              {
                "type": "null"
              }
            ]
          },
          "repairShop": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RepairShop"
              },
              {
                "type": "null"
              }
            ]
          },
          "inspection": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Inspection"
              },
              {
                "type": "null"
              }
            ]
          },
          "settlementAmount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "settledDeductible": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "The deductible applied, captured at settlement. Zero when glass cover paid a glass claim."
          }
        }
      },
      "Invoice": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "amount",
          "dueOn",
          "status",
          "paidWith",
          "paidAt",
          "refundedAt",
          "refundReason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "maxLength": 200
          },
          "amount": {
            "type": "integer",
            "minimum": 0
          },
          "dueOn": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "unpaid",
              "paid",
              "refunded"
            ]
          },
          "paidWith": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "Visa ending 1111"
            ]
          },
          "paidAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "refundedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "refundReason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CardInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nameOnCard",
          "cardNumber",
          "expiry",
          "cvv"
        ],
        "properties": {
          "nameOnCard": {
            "type": "string",
            "maxLength": 80
          },
          "cardNumber": {
            "type": "string",
            "description": "16 digits, spaces and hyphens allowed. Only 4111111111111111 is accepted."
          },
          "expiry": {
            "type": "string",
            "pattern": "^(0[1-9]|1[0-2])/\\d{2}$"
          },
          "cvv": {
            "type": "string",
            "pattern": "^\\d{3}$"
          }
        }
      },
      "DemoMessage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sender",
          "body",
          "sentAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
