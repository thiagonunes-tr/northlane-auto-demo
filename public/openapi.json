        "properties": {
          "customer": {
            "type": [
              "string",
              "null"
            ]
          },
          "agent": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DemoState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy",
          "vehicles",
          "drivers",
          "quote",
          "claims",
          "assistance",
          "invoices",
          "paymentMethods",
          "messages",
          "lastRead"
        ],
        "properties": {
          "policy": {
            "$ref": "#/components/schemas/Policy"
          },
          "vehicles": {
            "type": "array",
