              "$ref": "#/components/schemas/Vehicle"
            }
          },
          "drivers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/Driver"
            }
          },
          "quote": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Quote"
              },
              {
                "type": "null"
              }
            ]
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "description": "Newest first. At most one may be open."
          },
          "assistance": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssistanceRequest"
            }
          },
          "invoices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Invoice"
            },
            "description": "Newest first."
          },
          "paymentMethods": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/PaymentMethod"
            }
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DemoMessage"
            }
          },
          "lastRead": {
            "$ref": "#/components/schemas/MessageReadState"
          }
        },
        "description": "One row, shared by every session in the environment."
      },
